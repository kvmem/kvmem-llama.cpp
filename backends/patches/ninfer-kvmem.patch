+void VisionPrefillSession::rewind(std::uint32_t begin) {
+    if (overlay_ || begin >= prompt_.token_ids.size()) {
+        throw std::logic_error("Vision replay requires resident or CPU Vision and a valid prefill frontier");
+    }
+    // A prefetched CPU result belongs to the old forward cursor. Join its worker
+    // before discarding that association and re-encoding retained query payloads.
+    if (cpu_ && submitted_item_) {
+        (void)cpu_->complete_item();
+        submitted_item_.reset();
+    }
+    next_use_ = 0;
+    while (next_use_ < plan_.uses.size() && plan_.uses[next_use_].end <= begin) ++next_use_;
+    for (auto use = next_use_; use < plan_.uses.size(); ++use) {
+        if (!prompt_.media_payloads.at(plan_.uses[use].prepared_item_index))
+            throw std::logic_error("Vision query replay lost an unconsumed media payload");
+    }
+    retire_handoff();
+    prepared_end_ = begin;
+    active_use_end_ = 0;
+    encoded_payloads_pending_release_.clear();
+}
