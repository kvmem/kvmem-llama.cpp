+    ninfer::PromptInput input;
+    input.options.enable_thinking = false;
+    input.context_cache.session_key = key;
+    const auto add = [&](ninfer::ChatRole role, std::string text) {
+        ninfer::ChatMessage message;
+        message.role = role;
+        message.parts.push_back({.kind = ninfer::MessagePartKind::Text, .text = std::move(text)});
+        input.messages.push_back(std::move(message));
+    };
+    add(ninfer::ChatRole::System, "Read archive " + key + ". Its access code is " + code + ".");
+    if (image) {
+        add(ninfer::ChatRole::User, "Keep this archive image for later questions.");
+        input.messages.back().parts.push_back({.kind = ninfer::MessagePartKind::Media, .media = *image});
+        add(ninfer::ChatRole::Assistant, "Recorded.");
+    }
+    for (int entry = 0; entry < 16; ++entry) {
+        std::string text = "Entry " + std::to_string(entry) + ". ";
+        for (int repeat = 0; repeat < 8; ++repeat)
+            text += "The observatory files reports about pulsars, cosmic rays and distant galaxies. ";
+        add(ninfer::ChatRole::User, text);
+        add(ninfer::ChatRole::Assistant, "Recorded.");
+    }
+    add(ninfer::ChatRole::User, image
+        ? "Start with the archive access code and the color of the supplied image in English, then explain what the observatory studies."
+        : "Start with the archive access code, then explain what the observatory studies.");
+    if (image) input.messages.back().parts.push_back({.kind = ninfer::MessagePartKind::Media, .media = *image});
+    return input;
+}
+struct Sink final : ninfer::OutputSink {
+    bool cancel_enabled = false;
+    std::atomic<std::uint32_t>* started = nullptr;
+    std::uint32_t row_bit = 0;
+    std::uint32_t cancel_after_started = 0;
+    std::atomic<bool> cancelled{false};
+    void start(ninfer::GenerationStart) override {}
+    void progress(ninfer::PromptProgress) override {}
+    void publish(ninfer::OutputDelta) override {}
+    void timing(ninfer::GenerationTimingObservation value) override {
+        if (value.generated_tokens && started) started->fetch_or(row_bit);
+        if (cancel_enabled && value.generated_tokens >= 12 &&
+            (!started || (started->load() & cancel_after_started) == cancel_after_started))
+            cancelled.store(true);
+    }
+};
+struct Work {
+    ninfer::PromptInput prompt;
+    std::uint32_t output = 96;
+    bool cancel = false;
+    std::string expected_code;
+    std::string expected_color;
+};
+}
+
+int main(int argc, char** argv) {
+    try {
+        require((argc >= 5 && argc <= 9) || argc == 12 || argc == 13,
+                "artifact draft-count(0..15) concurrency(2..8) host-MiB [bf16|int8|fp8|nvfp4|k8v4|rk8v4|rk4v4|rk4v4-e8|rk2v4-e8] [eager|graph] [fixed|fast|adaptive|adaptive-fast] [disk-MiB | red.png blue.png resident|cpu vision-tokens [selected-tokens]]");
+        const auto drafts = static_cast<std::uint32_t>(std::stoul(argv[2]));
+        const auto concurrency = static_cast<std::uint32_t>(std::stoul(argv[3]));
+        require(concurrency >= 2 && concurrency <= 8, "concurrency must be in [2,8]");
+        ninfer::EngineOptions options;
+        ninfer::test::kvmem_test_devices(options);
+        options.artifact_path = argv[1];
+        options.device_profile = "off";
+        options.max_context = 8192;
+        options.max_concurrency = concurrency;
+        // This correctness run synchronously verifies every transferred KV/state
+        // byte; queued requests must survive that diagnostic cost.
+        options.pending_timeout_ms = 600000;
+        options.prefill_chunk = 128;
+        options.kv_cache = argc >= 6 ? ninfer::test::kvmem_test_storage(argv[5])
+                                    : ninfer::KvCacheStorage::Int8Group64;
+        if (argc >= 7) options.use_cuda_graph = ninfer::test::kvmem_test_graph(argv[6]);
+        options.kv_capacity = ninfer::KvCapacityPolicy::explicit_capacity(512 * concurrency);
+        options.kvmem = {.selected_tokens = 384, .reserve_tokens = 128,
+            .host_bytes = std::stoull(argv[4]) << 20, .retained_sessions = concurrency,
+            .verify_transfers = true};
+        options.context_cache.enabled = false;
+        if (argc == 9) {
+            options.kvmem.disk_bytes = std::stoull(argv[8]) << 20;
+            options.kvmem.disk_path = std::filesystem::temp_directory_path() /
+                ("ninfer-concurrent-ssd-" + std::to_string(std::chrono::steady_clock::now().time_since_epoch().count()));
+        }
+        if (drafts) {
+            options.speculative.backend = ninfer::SpeculativeBackend::Mtp;
+            options.speculative.draft_tokens = drafts;
+        }
+        if (argc >= 8) {
+            const std::string feature = argv[7];
+            require(feature == "fixed" || feature == "fast" || feature == "adaptive" || feature == "adaptive-fast", "invalid feature");
+            options.fast_prefill_kernel = feature == "fast" || feature == "adaptive-fast";
+            if (feature == "adaptive" || feature == "adaptive-fast")
+                options.speculative.mtp_policy = ninfer::MtpDraftPolicy::Adaptive;
+        }
+        ninfer::OwnedMedia red, blue;
+        if (argc >= 12) {
+            options.enable_vision = true;
+            options.kvmem.selected_tokens = argc == 13 ? static_cast<std::uint32_t>(std::stoul(argv[12])) : 1536;
+            options.kv_capacity = ninfer::KvCapacityPolicy::explicit_capacity(
+                options.kvmem.device_tokens() * concurrency);
+            const std::string residency = argv[10];
+            require(residency == "resident" || residency == "cpu", "invalid Vision residency");
+            options.vision_residency = residency == "cpu" ? ninfer::VisionResidency::Cpu
+                                                         : ninfer::VisionResidency::Resident;
+            options.vision_max_merged_tokens = static_cast<std::uint32_t>(std::stoul(argv[11]));
+            red = media(argv[8]); blue = media(argv[9]);
+        }
+        std::cout << "MEMORY_OPTIONS concurrency=" << concurrency << " drafts=" << drafts
+                  << " selected=" << options.kvmem.selected_tokens
+                  << " reserve=" << options.kvmem.reserve_tokens
+                  << " host=" << options.kvmem.host_bytes
+                  << " vision_limit=" << options.vision_max_merged_tokens << std::endl;
+        auto engine_owner = std::make_unique<ninfer::Engine>(options);
+        auto& engine = *engine_owner;
+        const bool pressure = !options.kvmem.disk_bytes && options.kvmem.host_bytes <
+            ninfer::test::kvmem_test_host_bytes(256ULL << 20, options.kv_cache);
+        const auto batch = [&](const char* label, std::vector<Work> jobs, bool expect_batch) {
+            std::vector<ninfer::PreparedPrompt> prepared;
+            for (auto& job : jobs) {
+                prepared.push_back(engine.prepare(job.prompt));
+                const auto& prompt = prepared.back();
+                std::cout << "MEMORY_PREPARE " << label << " lane=" << prepared.size() - 1
+                          << " tokens=" << prompt.summary().prompt_tokens
+                          << " vision_tokens=" << prompt.preparation_stats().vision_tokens
+                          << " media_items=" << prompt.preparation_stats().media_items << std::endl;
+            }
+            const auto before = engine.runtime_stats();
+            std::vector<std::future<ninfer::GenerationResult>> futures;
+            std::atomic<std::uint32_t> started{0};
+            const auto cancel_after_started = expect_batch ? (1U << jobs.size()) - 1U : 0U;
+            for (std::size_t row = 0; row < jobs.size(); ++row) {
+                ninfer::RequestOptions request;
+                request.execution.requested_output_tokens = jobs[row].output;
+                request.execution.sampling.temperature = 0;
+                request.stop.include_model_defaults = false;
+                auto handle = engine.submit(std::move(prepared[row]), request,
+                    ninfer::OutputConsumerMode::Streaming, {.live_timings = true});
+                futures.push_back(std::async(std::launch::async,
+                    [handle = std::move(handle), cancel = jobs[row].cancel, row,
+                     &started, cancel_after_started]() mutable {
+                        Sink sink;
+                        sink.cancel_enabled = cancel;
+                        sink.started = &started;
+                        sink.row_bit = 1U << row;
+                        sink.cancel_after_started = cancel_after_started;
+                        return handle.wait(&sink, ninfer::CancellationView([&] {
+                            return sink.cancelled.load();
+                        }));
+                    }));
+            }
+            std::uint32_t peak_running = 0, peak_waiting = 0;
+            while (std::any_of(futures.begin(), futures.end(), [](auto& future) {
+                return future.wait_for(std::chrono::milliseconds(0)) != std::future_status::ready;
+            })) {
+                const auto stats = engine.runtime_stats();
+                peak_running = std::max(peak_running, stats.running_requests);
+                peak_waiting = std::max(peak_waiting, stats.waiting_requests);
+                require(stats.kvmem.host_payload_bytes <= options.kvmem.host_bytes,
+                        "concurrent archives exceeded global H");
+                require(stats.kvmem.active_payload_reservation_bytes <= stats.kvmem.retained_payload_budget_bytes,
+                        "admission overcommitted retained payload capacity");
+                require(stats.kvmem.disk_payload_bytes <= options.kvmem.disk_bytes,
+                        "concurrent archives exceeded global D");
+                std::this_thread::sleep_for(std::chrono::milliseconds(25));
+            }
+            std::vector<ninfer::GenerationResult> results;
+            for (std::size_t row = 0; row < futures.size(); ++row) {
+                auto result = futures[row].get();
+                require(jobs[row].cancel ? result.finish_reason == ninfer::FinishReason::Cancelled
+                                        : result.generated_token_ids.size() == jobs[row].output,
+                        "one lane affected another lane's termination");
+                if (!jobs[row].cancel && drafts)
+                    require(result.speculative.accepted_tokens > 0, "MTP was silently disabled");
+                if (options.speculative.mtp_policy == ninfer::MtpDraftPolicy::Adaptive) {
+                    require(result.speculative.adaptive, "adaptive MTP was silently disabled");
+                    std::cout << "MEMORY_ADAPTIVE " << label << " lane=" << row
+                              << " transitions=" << result.speculative.window_transitions << " windows=";
+                    for (auto count : result.speculative.rounds_per_window) std::cout << count << ',';
+                    std::cout << std::endl;
+                }
+                if (!jobs[row].cancel && !jobs[row].expected_code.empty())
+                    if (result.content.find(jobs[row].expected_code) == std::string::npos)
+                        throw std::runtime_error(std::string(label) + " lane=" + std::to_string(row) +
+                            " returned the wrong archive access code: " + result.content.substr(0, 256));
+                if (!jobs[row].expected_color.empty()) {
+                    require(result.prompt.has_media, "concurrent image request lost media");
+                    auto content = result.content;
+                    std::transform(content.begin(), content.end(), content.begin(),
+                        [](unsigned char value) { return std::tolower(value); });
+                    if (!jobs[row].cancel)
+                        if (content.find(jobs[row].expected_color) == std::string::npos)
+                            throw std::runtime_error(std::string(label) + " lane=" + std::to_string(row) +
+                                " returned another lane's color: " + result.content.substr(0, 256));
+                } else {
+                    require(!result.prompt.has_media, "text request acquired another lane's image");
+                }
+                results.push_back(std::move(result));
+            }
+            require(engine.is_available(), "concurrent run made Engine unavailable");
+            const auto after = engine.runtime_stats();
+            const auto rounds = after.decode_rounds - before.decode_rounds;
+            const auto rows = after.decode_row_rounds - before.decode_row_rounds;
+            std::cout << "MEMORY_BATCH " << label << " rounds=" << rounds << " rows=" << rows
+                      << " peak_running=" << peak_running << " peak_waiting=" << peak_waiting << std::endl;
+            if (expect_batch) require(rows > rounds && peak_running >= 2,
+                                      "requests did not execute in a compact decode batch");
+            if (expect_batch && std::string(label) == "cancel-one")
+                require(peak_running == concurrency, "configured lanes were not concurrently active");
+            if (pressure && jobs.size() > 1)
+                require(peak_running == 1 && peak_waiting > 0,
+                        "Host pressure did not queue requests until a reservation was released");
+            const auto memory = engine.memory_summary().kvmem;
+            if (options.kvmem.disk_bytes) {
+                std::cout << "MEMORY_SSD " << label << " H=" << memory.host_payload_bytes
+                          << " D=" << memory.disk_payload_bytes << " reads=" << memory.disk_read_bytes
+                          << " writes=" << memory.disk_written_bytes << " errors=" << memory.disk_errors << std::endl;
+                require(memory.disk_written_bytes && !memory.disk_errors,
+                        "concurrent SSD fixture did not perform successful writes");
+                if (std::string(label) != "mixed-prefill")
+                    require(memory.disk_read_bytes, "retained concurrent sessions did not read SSD");
+            }
+            require(memory.resident_pages == 0 && memory.mtp_resident_pages == 0 &&
+                    memory.active_payload_reservation_bytes == 0, "terminal lanes retained active resources");
+            std::cout << "MEMORY_CONCURRENCY " << label << " rounds=" << rounds << " rows=" << rows
+                      << " peak_running=" << peak_running << " peak_waiting=" << peak_waiting
+                      << " host=" << memory.host_payload_bytes << std::endl;
+            return results;
+        };
+        std::vector<Work> initial;
+        for (std::uint32_t row = 0; row < concurrency; ++row) {
+            const auto* image = !options.enable_vision || row % 3 == 2 ? nullptr
+                                : row % 3 == 0 ? &red : &blue;
+            initial.push_back({history("lane-" + std::to_string(row), "ORCHID-" + std::to_string(7100 + row), image),
+                               192 - row * 16, false, "ORCHID-" + std::to_string(7100 + row),
+                               image == &red ? "red" : image == &blue ? "blue" : ""});
+        }
+        // CPU image encoding and staged prefill are serialized. A cold short
+        // reply may finish before another image lane becomes decode-ready.
+        // Unchanged warm sessions below still must form a compact batch and fill all lanes.
+        batch("mixed-prefill", initial, !pressure && !options.enable_vision);
+        initial.front().cancel = true;
+        batch("cancel-one", initial, !pressure);
+        initial.front().cancel = false;
+        for (auto& job : initial) job.output = 32;
+        batch("resume-peers", initial, !pressure);
+        if (options.enable_vision && !pressure) {
+            initial[0].prompt = history("lane-0", "ORCHID-7100", &blue);
+            initial[0].expected_color = "blue";
+            initial[0].output = 96;
+            // Changing the image invalidates its archived prefix and runs cold
+            // image prefill again. The short unchanged peers need not overlap it.
+            batch("replace-image", initial, false);
+        }
+        if (!pressure) {
+            auto older = history("shared", "OLDER-8010");
+            auto newer = history("shared", "NEWER-9020");
+            batch("publication-order", {{older, 768, false, "OLDER-8010"},
+                                        {newer, 24, false, "NEWER-9020"}}, true);
+            const auto repeat = batch("newer-retained", {{newer, 24, false}}, false);
+            require(repeat.front().reused_prompt_tokens > 0, "older late finish replaced newer session history");
+        }
+        engine_owner.reset();
+        if (options.kvmem.disk_bytes) {
+            require(std::filesystem::is_empty(options.kvmem.disk_path), "concurrent spill file leaked");
+            std::filesystem::remove(options.kvmem.disk_path);
+        }
+        std::cout << "MEMORY_CONCURRENCY PASS" << std::endl;
+    } catch (const std::exception& error) {
+        std::cerr << error.what() << '\n';
+        return 1;
+    }
+}
diff --git a/tests/experimental/memory_disk.cpp b/tests/experimental/memory_disk.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..425ec07c5a5edc3d39cc762ce068173ef2a923d2
--- /dev/null
+++ b/tests/experimental/memory_disk.cpp
@@ -0,0 +1,133 @@
+#include "ninfer/engine.h"
+#include "kvmem_test_options.h"
+#include <atomic>
+#include <filesystem>
+#include <fstream>
+#include <iostream>
+#include <stdexcept>
+
+namespace {
+void require(bool value, const char* message) {
+    if (!value) throw std::runtime_error(message);
+}
+struct Sink final : ninfer::OutputSink {
+    bool cancel = false;
+    std::atomic<bool> cancelled{false};
+    void start(ninfer::GenerationStart) override {}
+    void progress(ninfer::PromptProgress) override {}
+    void publish(ninfer::OutputDelta) override {}
+    void timing(ninfer::GenerationTimingObservation value) override {
+        if (cancel && value.generated_tokens >= 12) cancelled = true;
+    }
+};
+}
+int main(int argc, char** argv) {
+    try {
+        require(argc >= 7 && argc <= 11, "artifact drafts(0..15) bf16|int8|nvfp4|k8v4|rk8v4 cache-dir cold|hit|error|cancel|clear quota-MiB [ngram-width] [short|long] [eager|graph] [adaptive]");
+        ninfer::EngineOptions options;
+        options.artifact_path = argv[1];
+        options.device_profile = "off";
+        options.max_context = 4096; options.prefill_chunk = 128;
+        options.kv_capacity = ninfer::KvCapacityPolicy::explicit_capacity(512);
+        options.kv_cache = ninfer::test::kvmem_test_storage(argv[3]);
+        options.context_cache.enabled = false;
+        options.kvmem = {.selected_tokens = 384, .reserve_tokens = 128,
+            .host_bytes = 512ULL << 20, .retained_sessions = 2, .verify_transfers = true,
+            .disk_path = argv[4], .disk_bytes = std::stoull(argv[6]) << 20};
+        const auto drafts = static_cast<std::uint32_t>(std::stoul(argv[2]));
+        if (drafts) {
+            options.speculative.backend = ninfer::SpeculativeBackend::Mtp;
+            options.speculative.draft_tokens = drafts;
+        }
+        if (argc >= 8) options.speculative.ngram_draft_tokens = static_cast<std::uint32_t>(std::stoul(argv[7]));
+        if (argc >= 10) options.use_cuda_graph = ninfer::test::kvmem_test_graph(argv[9]);
+        if (argc == 11) {
+            require(std::string(argv[10]) == "adaptive", "expected adaptive");
+            options.speculative.mtp_policy = ninfer::MtpDraftPolicy::Adaptive;
+        }
+        ninfer::Engine engine(options);
+        ninfer::PromptInput input;
+        input.options.enable_thinking = false;
+        input.options.preserve_thinking = true;
+        input.context_cache.session_key = "disk-history";
+        const auto add = [&](ninfer::ChatRole role, std::string text) {
+            ninfer::ChatMessage message;
+            message.role = role;
+            message.parts.push_back({.kind = ninfer::MessagePartKind::Text, .text = std::move(text)});
+            input.messages.push_back(std::move(message));
+        };
+        add(ninfer::ChatRole::System, "The archive access code is ORCHID-9491. Remember it.");
+        for (int entry = 0; entry < (argc >= 9 && std::string(argv[8]) == "short" ? 0 : 8); ++entry) {
+            std::string text = "Entry " + std::to_string(entry) + ". ";
+            for (int i = 0; i < 8; ++i) text += "The observatory records pulsars, galaxies and meteor showers. ";
+            add(ninfer::ChatRole::User, text); add(ninfer::ChatRole::Assistant, "Recorded.");
+        }
+        add(ninfer::ChatRole::User, "Start with the access code, then describe the observatory.");
+        const std::string mode = argv[5];
+        const bool endpoint = mode.starts_with("endpoint-");
+        std::uint32_t endpoint_frontier = 0;
+        if (endpoint) {
+            std::string source = "Copy exactly, starting with ORCHID-9491:\n";
+            for (int i = 0; i < 80; ++i)
+                source += "Record " + std::to_string(i) + ": violet stars and distant galaxies.\n";
+            input.messages.back().parts[0].text = source;
+            endpoint_frontier = engine.prepare(input).summary().prompt_tokens + 95;
+            if (mode == "endpoint-hit") {
+                std::ifstream saved(std::filesystem::path(argv[4]) / "endpoint.txt", std::ios::binary);
+                require(bool(saved >> endpoint_frontier), "endpoint replay fixture missing");
+                saved.get();
+                std::string content((std::istreambuf_iterator<char>(saved)), {});
+                add(ninfer::ChatRole::Assistant, std::move(content));
+                add(ninfer::ChatRole::Tool, "Continue copying the next records.");
+            }
+        }
+        ninfer::RequestOptions request;
+        request.execution.requested_output_tokens = mode == "cancel" ? 128 : mode == "endpoint-cold" ? 96 : 32;
+        request.execution.sampling.temperature = 0;
+        request.execution.allow_prefix_reuse = mode != "clear";
+        request.stop.include_model_defaults = false;
+        Sink sink; sink.cancel = mode == "cancel";
+        const auto result = engine.submit(engine.prepare(input), request,
+            ninfer::OutputConsumerMode::Streaming, {.live_timings = true})
+            .wait(&sink, ninfer::CancellationView([&] { return sink.cancelled.load(); }));
+        const auto memory = engine.memory_summary().kvmem;
+        const bool hit = mode == "hit" || mode == "cancel" || mode == "endpoint-hit";
+        require((result.reused_prompt_tokens > 0) == hit, "wrong disk reuse decision");
+        require((memory.disk_hits != 0) == hit, "disk hit counter does not match reuse");
+        require(engine.is_available() && memory.resident_pages == 0 && memory.mtp_resident_pages == 0,
+                "snapshot path leaked active resources or failed the Engine");
+        require(memory.host_payload_bytes <= options.kvmem.host_bytes, "snapshot import exceeded H");
+        require(mode == "cancel" ? result.finish_reason == ninfer::FinishReason::Cancelled
+                                 : result.generated_token_ids.size() == request.execution.requested_output_tokens,
+                "wrong generation termination");
+        if (mode != "cancel" && mode != "endpoint-hit")
+            require(result.content.find("ORCHID-9491") != std::string::npos, "wrong recovered archive code");
+        if (mode == "endpoint-cold") {
+            std::ofstream saved(std::filesystem::path(argv[4]) / "endpoint.txt", std::ios::binary);
+            saved << endpoint_frontier << '\n' << result.content;
+            require(bool(saved), "endpoint fixture publication failed");
+        }
+        if (mode == "endpoint-hit") {
+            require(result.reused_prompt_tokens == endpoint_frontier &&
+                    result.prefix_reuse_path == ninfer::PrefixReusePath::PrivateEndpoint,
+                    "cold endpoint did not restore generated output with its frozen query");
+        }
+        if (mode == "error") require(memory.disk_errors > 0, "snapshot failure was not reported");
+        if (mode != "error" && mode != "clear") require(memory.disk_writes > 0, "trusted checkpoint was not persisted");
+        if (mode == "clear") require(memory.disk_writes == 0, "explicit clear republished the discarded history");
+        if (options.speculative.mtp_policy == ninfer::MtpDraftPolicy::Adaptive) {
+            require(result.speculative.adaptive, "adaptive MTP was silently disabled");
+            std::cout << "MEMORY_ADAPTIVE disk transitions=" << result.speculative.window_transitions << " windows=";
+            for (auto count : result.speculative.rounds_per_window) std::cout << count << ',';
+            std::cout << std::endl;
+        }
+        std::cout << "MEMORY_DISK mode=" << mode << " reused=" << result.reused_prompt_tokens
+                  << " hits=" << memory.disk_hits << " writes=" << memory.disk_writes
+                  << " errors=" << memory.disk_errors << " host=" << memory.host_payload_bytes
+                  << " accepted=" << result.speculative.accepted_tokens << std::endl;
+        std::cout << "MEMORY_DISK PASS" << std::endl;
+    } catch (const std::exception& error) {
+        std::cerr << error.what() << std::endl;
+        return 1;
+    }
+}
diff --git a/tests/experimental/memory_ngram.cpp b/tests/experimental/memory_ngram.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..266e2585c26709958e6f7404448ec89b7eb97db9
--- /dev/null
+++ b/tests/experimental/memory_ngram.cpp
@@ -0,0 +1,366 @@
+#include "ninfer/engine.h"
+#include "kvmem_test_options.h"
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cctype>
+#include <cstdlib>
+#include <fstream>
+#include <future>
+#include <iostream>
+#include <iterator>
+#include <set>
+#include <stdexcept>
+#include <thread>
+#include <vector>
+
+namespace {
+void require(bool condition, const char* message) {
+    if (!condition) throw std::runtime_error(message);
+}
+void add(ninfer::PromptInput& input, ninfer::ChatRole role, const std::string& text) {
+    ninfer::ChatMessage message;
+    message.role = role;
+    message.parts.push_back({.kind = ninfer::MessagePartKind::Text, .text = text});
+    input.messages.push_back(std::move(message));
+}
+struct Sink final : ninfer::OutputSink {
+    std::uint32_t stop_after = 0;
+    std::atomic<bool> cancelled{false};
+    void start(ninfer::GenerationStart) override {}
+    void progress(ninfer::PromptProgress) override {}
+    void publish(ninfer::OutputDelta) override {}
+    void timing(ninfer::GenerationTimingObservation value) override {
+        if (stop_after && value.generated_tokens >= stop_after) cancelled = true;
+    }
+};
+ninfer::OwnedMedia media(const char* path) {
+    std::ifstream file(path, std::ios::binary);
+    require(file.good(), "image fixture missing");
+    ninfer::OwnedMedia result;
+    result.bytes.assign(std::istreambuf_iterator<char>(file), {});
+    result.media_type = "image/png";
+    result.source_name = "image.png";
+    return result;
+}
+std::string prefix(int seed) {
+    return "def transform_" + std::to_string(seed) + "(value):\n    offset = " + std::to_string(seed + 17);
+}
+std::string source(int seed) {
+    std::string result;
+    for (int index = 0; index < 20; ++index) {
+        const int value = seed + index;
+        result += prefix(value) + "\n    return value * " + std::to_string(value + 2) + " + offset\n\n";
+    }
+    return result;
+}
+void concurrent(ninfer::Engine& engine, const ninfer::EngineOptions& options,
+                const ninfer::OwnedMedia& red, const ninfer::OwnedMedia& blue) {
+    const auto lanes = options.max_concurrency;
+    std::vector<ninfer::PromptInput> prompts;
+    std::vector<int> seeds;
+    for (unsigned row = 0; row < lanes; ++row) {
+        const int seed = 100 + 100 * row;
+        seeds.push_back(seed);
+        ninfer::PromptInput input;
+        input.context_cache.session_key = "ngram-lane-" + std::to_string(row);
+        input.options.enable_thinking = false;
+        add(input, ninfer::ChatRole::System, "Copy complete files exactly when asked, preserving every function and every newline.");
+        for (int entry = 0; entry < 8; ++entry) {
+            std::string filler;
+            for (int repeat = 0; repeat < 8; ++repeat)
+                filler += "The observatory records pulsars, galaxies and meteor showers. ";
+            add(input, ninfer::ChatRole::User, filler);
+            add(input, ninfer::ChatRole::Assistant, "Recorded.");
+        }
+        add(input, ninfer::ChatRole::User, row == lanes - 1
+            ? "Explain how hash tables resolve collisions in detail."
+            : "Repeat the following Python file exactly. Output only the file, with no explanation or Markdown fences. "
+              "Preserve every space and newline.\n\n" + source(seed));
+        if (options.enable_vision && row % 3 != 2) {
+            input.messages.back().parts.push_back({.kind = ninfer::MessagePartKind::Media,
+                .media = row % 3 == 0 ? red : blue});
+        }
+        if (row != lanes - 1) {
+            add(input, ninfer::ChatRole::Assistant, prefix(seed));
+            input.options.continuation = ninfer::PromptContinuationMode::ContinueFinalAssistant;
+        }
+        prompts.push_back(std::move(input));
+    }
+    const auto batch = [&](const char* name, int cancel_row, bool restored, bool full_overlap) {
+        std::vector<ninfer::PreparedPrompt> prepared;
+        for (const auto& prompt : prompts) prepared.push_back(engine.prepare(prompt));
+        std::atomic<unsigned> started{0};
+        const unsigned all_started = (1U << lanes) - 1U;
+        struct LaneSink final : ninfer::OutputSink {
+            std::atomic<unsigned>& started;
+            unsigned bit, all;
+            bool cancel;
+            std::atomic<bool> cancelled{false};
+            LaneSink(std::atomic<unsigned>& value, unsigned row, unsigned mask, bool enabled)
+                : started(value), bit(1U << row), all(mask), cancel(enabled) {}
+            void start(ninfer::GenerationStart) override {}
+            void progress(ninfer::PromptProgress) override {}
+            void publish(ninfer::OutputDelta) override {}
+            void timing(ninfer::GenerationTimingObservation value) override {
+                if (value.generated_tokens) started.fetch_or(bit);
+                if (cancel && value.generated_tokens >= 16 && (started.load() & all) == all)
+                    cancelled = true;
+            }
+        };
+        const auto before = engine.runtime_stats();
+        std::vector<std::future<ninfer::GenerationResult>> futures;
+        for (unsigned row = 0; row < lanes; ++row) {
+            ninfer::RequestOptions request;
+            request.execution.requested_output_tokens = 256;
+            request.execution.sampling.temperature = 0.0F;
+            request.stop.include_model_defaults = true;
+            auto handle = engine.submit(std::move(prepared[row]), request,
+                ninfer::OutputConsumerMode::Streaming, {.live_timings = true});
+            futures.push_back(std::async(std::launch::async,
+                [handle = std::move(handle), &started, row, all_started, cancel_row]() mutable {
+                    LaneSink sink(started, row, all_started, static_cast<int>(row) == cancel_row);
+                    return handle.wait(&sink, ninfer::CancellationView([&] { return sink.cancelled.load(); }));
+                }));
+        }
+        unsigned peak = 0;
+        while (std::any_of(futures.begin(), futures.end(), [](auto& future) {
+            return future.wait_for(std::chrono::milliseconds(0)) != std::future_status::ready;
+        })) {
+            const auto stats = engine.runtime_stats();
+            peak = std::max(peak, stats.running_requests);
+            require(stats.kvmem.host_payload_bytes <= options.kvmem.host_bytes &&
+                    stats.kvmem.active_payload_reservation_bytes <= options.kvmem.host_bytes,
+                    "concurrent ngram exceeded global H");
+            std::this_thread::sleep_for(std::chrono::milliseconds(10));
+        }
+        std::uint64_t accepted = 0;
+        std::vector<ninfer::GenerationResult> results;
+        for (unsigned row = 0; row < lanes; ++row) {
+            auto result = futures[row].get();
+            const bool cancelled = static_cast<int>(row) == cancel_row;
+            require((result.finish_reason == ninfer::FinishReason::Cancelled) == cancelled,
+                    "ngram cancellation crossed lanes");
+            require((result.reused_prompt_tokens > 0) == restored,
+                    "concurrent ngram history reuse changed");
+            require(result.prompt.has_media == (options.enable_vision && row % 3 != 2),
+                    "concurrent ngram media crossed lanes");
+            if (row != lanes - 1) {
+                const auto produced = prefix(seeds[row]) + result.content;
+                if (!source(seeds[row]).starts_with(produced))
+                    throw std::runtime_error(std::string(name) + " copy lane " + std::to_string(row) +
+                                             " diverged: " + produced.substr(0, 256));
+                if (!cancelled) require(result.speculative.ngram_accepted_tokens > 0,
+                                        "concurrent copy lane did not engage ngram");
+                accepted += result.speculative.ngram_accepted_tokens;
+            } else {
+                const std::set<ninfer::TokenId> distinct(result.generated_token_ids.begin(), result.generated_token_ids.end());
+                require(result.generated_token_ids.size() >= 32 && distinct.size() >= 16,
+                        "mixed neural lane output degenerated");
+            }
+            if (options.speculative.mtp_policy == ninfer::MtpDraftPolicy::Adaptive)
+                require(result.speculative.adaptive, "concurrent adaptive MTP silently disabled");
+            std::cout << "MEMORY_NGRAM_LANE case=" << name << " row=" << row
+                      << " reused=" << result.reused_prompt_tokens << " generated=" << result.generated_token_ids.size()
+                      << " accepted=" << result.speculative.ngram_accepted_tokens << std::endl;
+            results.push_back(std::move(result));
+        }
+        const auto after = engine.runtime_stats();
+        const auto rounds = after.decode_rounds - before.decode_rounds;
+        const auto rows = after.decode_row_rounds - before.decode_row_rounds;
+        std::cout << "MEMORY_NGRAM_BATCH case=" << name << " peak=" << peak << " rounds=" << rounds
+                  << " rows=" << rows << " accepted=" << accepted << std::endl;
+        // Cold prefills are serialized. A fast copy lane can finish before the
+        // next CPU-image lane reaches decode. Require actual full overlap in
+        // each restored phase, independent of this cold-admission timing.
+        require(rows >= rounds && peak >= 1 && (!full_overlap || (rows > rounds && peak == lanes)),
+                "ngram did not exercise compact concurrent decode");
+        const auto memory = engine.memory_summary().kvmem;
+        require(engine.is_available() && memory.resident_pages == 0 && memory.mtp_resident_pages == 0 &&
+                memory.active_payload_reservation_bytes == 0 && memory.host_payload_bytes <= options.kvmem.host_bytes,
+                "concurrent ngram leaked resources");
+        return results;
+    };
+    if (!std::getenv("NINFER_NGRAM_TEST_COLORS_ONLY")) {
+    const auto cold = batch("cold-mixed", -1, false, false);
+    const auto warm = batch("restored-mixed", -1, true, true);
+    for (unsigned row = 0; row + 1 < lanes; ++row)
+        require(cold[row].generated_token_ids == warm[row].generated_token_ids,
+                "concurrent restore changed exact copy tokens");
+    batch("cancel-one", 0, true, true);
+    const auto recovered = batch("recover-peers", -1, true, true);
+    for (unsigned row = 0; row + 1 < lanes; ++row)
+        require(warm[row].generated_token_ids == recovered[row].generated_token_ids,
+                "cancelled concurrent ngram polluted copy history");
+    }
+    if (options.enable_vision) {
+        std::vector<ninfer::PreparedPrompt> prepared;
+        for (unsigned row = 0; row < lanes; ++row) {
+            ninfer::PromptInput input;
+            input.options.enable_thinking = false;
+            input.context_cache.session_key = "ngram-color-" + std::to_string(row);
+            add(input, ninfer::ChatRole::System, "Answer questions about the supplied images in English.");
+            add(input, ninfer::ChatRole::User, "Answer with exactly one word: what color fills this image?");
+            input.messages.back().parts.push_back({.kind = ninfer::MessagePartKind::Media,
+                .media = row % 2 == 0 ? red : blue});
+            prepared.push_back(engine.prepare(input));
+        }
+        std::vector<ninfer::GenerationHandle> handles;
+        for (auto& input : prepared) {
+            ninfer::RequestOptions request;
+            request.execution.requested_output_tokens = 32;
+            request.execution.sampling.temperature = 0.0F;
+            handles.push_back(engine.submit(std::move(input), request));
+        }
+        for (unsigned row = 0; row < lanes; ++row) {
+            auto result = handles[row].wait();
+            std::transform(result.content.begin(), result.content.end(), result.content.begin(),
+                [](unsigned char value) { return static_cast<char>(std::tolower(value)); });
+            if (result.content.find(row % 2 == 0 ? "red" : "blue") == std::string::npos)
+                throw std::runtime_error("image color lane " + std::to_string(row) +
+                    " expected " + (row % 2 == 0 ? "red" : "blue") + ": " + result.content);
+            std::cout << "MEMORY_NGRAM_COLOR row=" << row << " correct=1" << std::endl;
+        }
+        const auto memory = engine.memory_summary().kvmem;
+        require(memory.resident_pages == 0 && memory.mtp_resident_pages == 0 &&
+                memory.active_payload_reservation_bytes == 0, "ngram color requests leaked resources");
+    }
+    std::cout << (std::getenv("NINFER_NGRAM_TEST_COLORS_ONLY")
+        ? "MEMORY_NGRAM_COLORS_ONLY PASS" : "MEMORY_NGRAM_CONCURRENT PASS") << std::endl;
+}
+}
+int main(int argc, char** argv) {
+    try {
+        require((argc >= 5 && argc <= 8) || argc == 11,
+                "artifact bf16|int8|fp8|nvfp4|k8v4|rk8v4|rk4v4|rk4v4-e8|rk2v4-e8 eager|graph ngram-width [mtp-drafts] [fixed|adaptive] [concurrency] [red.png blue.png resident|cpu]");
+        ninfer::EngineOptions options;
+        ninfer::test::kvmem_test_devices(options);
+        options.artifact_path = argv[1];
+        options.device_profile = "off"; options.max_context = 8192; options.prefill_chunk = 128;
+        options.context_cache.enabled = false;
+        options.kv_capacity = ninfer::KvCapacityPolicy::explicit_capacity(512);
+        options.kvmem = {.selected_tokens = 384, .reserve_tokens = 128,
+            .host_bytes = 512ULL << 20, .retained_sessions = 2, .verify_transfers = true};
+        options.kv_cache = ninfer::test::kvmem_test_storage(argv[2]);
+        options.use_cuda_graph = ninfer::test::kvmem_test_graph(argv[3]);
+        if (const auto* fast = std::getenv("NINFER_TEST_FAST_PREFILL")) {
+            require(std::string(fast) == "0" || std::string(fast) == "1", "NINFER_TEST_FAST_PREFILL must be 0 or 1");
+            options.fast_prefill_kernel = fast[0] == '1';
+        }
+        options.speculative.backend = ninfer::SpeculativeBackend::Mtp;
+        options.speculative.draft_tokens = argc >= 6 ? static_cast<std::uint32_t>(std::stoul(argv[5])) : 3;
+        options.speculative.ngram_draft_tokens = static_cast<std::uint32_t>(std::stoul(argv[4]));
+        options.speculative.ngram_min_match = 4;
+        if (argc >= 7) {
+            require(std::string(argv[6]) == "adaptive" || std::string(argv[6]) == "fixed", "expected fixed|adaptive");
+            if (std::string(argv[6]) == "adaptive") options.speculative.mtp_policy = ninfer::MtpDraftPolicy::Adaptive;
+        }
+        if (argc >= 8) {
+            options.max_concurrency = static_cast<std::uint32_t>(std::stoul(argv[7]));
+            require(options.max_concurrency >= 2 && options.max_concurrency <= 8, "expected concurrency 2..8");
+            options.kvmem.host_bytes = 512ULL * options.max_concurrency << 20;
+            options.kvmem.retained_sessions = options.max_concurrency;
+            // Preserve the complete ~600-token copy query while still selecting its longer history.
+            options.kvmem.selected_tokens = 768;
+            options.pending_timeout_ms = 600000;
+        }
+        ninfer::OwnedMedia red, blue;
+        if (argc == 11) {
+            options.enable_vision = true;
+            options.kvmem.selected_tokens = 1536;
+            options.vision_max_merged_tokens = 1024;
+            const std::string residency = argv[10];
+            require(residency == "resident" || residency == "cpu", "expected resident|cpu");
+            options.vision_residency = residency == "cpu" ? ninfer::VisionResidency::Cpu : ninfer::VisionResidency::Resident;
+            red = media(argv[8]); blue = media(argv[9]);
+        }
+        options.kv_capacity = ninfer::KvCapacityPolicy::explicit_capacity(options.kvmem.device_tokens() * options.max_concurrency);
+        std::cout << "MEMORY_FEATURE fast_prefill=" << options.fast_prefill_kernel << std::endl;
+        ninfer::Engine engine(options);
+        if (options.max_concurrency > 1) {
+            concurrent(engine, options, red, blue);
+            return 0;
+        }
+        ninfer::PromptInput prompt;
+        prompt.options.enable_thinking = false;
+        prompt.context_cache.session_key = "copy-history";
+        add(prompt, ninfer::ChatRole::System, "When asked to copy text, reproduce it verbatim, without explanations or quotation marks.");
+        for (int i = 0; i < 8; ++i) {
+            std::string filler;
+            for (int j = 0; j < 8; ++j) filler += "The observatory records pulsars, galaxies and meteor showers. ";
+            add(prompt, ninfer::ChatRole::User, filler);
+            add(prompt, ninfer::ChatRole::Assistant, "Recorded.");
+        }
+        std::string passage = "The violet observatory opens at sunrise. ";
+        for (int i = 0; i < 12; ++i)
+            passage += "Its telescope observes distant galaxies, while the astronomers record the changing light of stars. ";
+        add(prompt, ninfer::ChatRole::User, "Store this passage for exact copying later:\n" + passage);
+        add(prompt, ninfer::ChatRole::Assistant, "The passage is stored.");
+        add(prompt, ninfer::ChatRole::User, "Copy the stored passage exactly. Start with: The violet observatory opens at sunrise.");
+        const auto run = [&](const char* name, const ninfer::PromptInput& input, bool hit,
+                             std::uint32_t count = 192, std::uint32_t cancel = 0, float temperature = 0.0F) {
+            ninfer::RequestOptions request;
+            request.execution.requested_output_tokens = count;
+            request.execution.sampling.temperature = temperature;
+            request.execution.sampling.top_k = 20; request.execution.sampling.top_p = 0.9F;
+            request.execution.sampling.seed = 42;
+            request.execution.allow_prefix_reuse = true;
+            request.stop.include_model_defaults = false;
+            Sink sink; sink.stop_after = cancel;
+            const auto result = engine.submit(engine.prepare(input), request,
+                ninfer::OutputConsumerMode::Streaming, {.live_timings = true})
+                .wait(&sink, ninfer::CancellationView([&] { return sink.cancelled.load(); }));
+            const auto memory = engine.memory_summary().kvmem;
+            require(engine.is_available(), "ngram made Engine unavailable");
+            require((result.reused_prompt_tokens > 0) == hit, "ngram history reuse decision changed");
+            require(memory.host_payload_bytes <= options.kvmem.host_bytes &&
+                memory.resident_pages == 0 && memory.mtp_resident_pages == 0, "ngram leaked resources");
+            require(cancel ? result.finish_reason == ninfer::FinishReason::Cancelled
+                           : result.generated_token_ids.size() == count, "ngram output termination mismatch");
+            std::cout << "MEMORY_NGRAM case=" << name << " reused=" << result.reused_prompt_tokens
+                      << " generated=" << result.generated_token_ids.size()
+                      << " rounds=" << result.speculative.ngram_rounds
+                      << " drafted=" << result.speculative.ngram_drafted_tokens
+                      << " accepted=" << result.speculative.ngram_accepted_tokens << std::endl;
+            if (options.speculative.mtp_policy == ninfer::MtpDraftPolicy::Adaptive) {
+                require(result.speculative.adaptive, "adaptive MTP was silently disabled");
+                std::cout << "MEMORY_ADAPTIVE case=" << name
+                          << " transitions=" << result.speculative.window_transitions << " windows=";
+                for (auto count : result.speculative.rounds_per_window) std::cout << count << ',';
+                std::cout << std::endl;
+            }
