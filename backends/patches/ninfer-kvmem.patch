+        }
+        auto short_image = input("short");
+        add(short_image, ninfer::ChatRole::User, "What color fills this image?", {red});
+        run("single", short_image, {"red"}, false);
+
+        auto old_image = input("old-image");
+        add(old_image, ninfer::ChatRole::User, "Remember this image for a later question.", {red});
+        add(old_image, ninfer::ChatRole::Assistant, "I will remember it.");
+        filler(old_image);
+        add(old_image, ninfer::ChatRole::User, "What color filled the image at the start?");
+        run("old-image-cold", old_image, {"red"}, false);
+        run("old-image-repeat", old_image, {"red"}, true);
+        auto replacement = old_image;
+        replacement.messages[1].parts[0].media = blue;
+        run("same-placeholder-new-media", replacement, {"blue"}, false);
+        run("replacement-repeat", replacement, {"blue"}, true);
+        run("cancel", replacement, {}, true, true);
+        run("cancel-recovery", replacement, {"blue"}, true);
+
+        auto query_image = input("query-image");
+        filler(query_image);
+        add(query_image, ninfer::ChatRole::User, "What color fills this image?", {red});
+        run("query-image-replay", query_image, {"red"}, false);
+        run("query-image-repeat", query_image, {"red"}, true);
+        auto multiple = input("multiple");
+        filler(multiple);
+        add(multiple, ninfer::ChatRole::User, "Name the colors of the first and second images, in order.", {red, blue});
+        run("multiple-query-images", multiple, {"red", "blue"}, false);
+        if (memory) {
+            auto oversized = input("over-budget");
+            add(oversized, ninfer::ChatRole::User, "Describe all three images.", {red, blue, red});
+            bool rejected = false;
+            try {
+                ninfer::RequestOptions request;
+                request.execution.requested_output_tokens = 16;
+                (void)engine.generate(engine.prepare(std::move(oversized)), request);
+            } catch (const ninfer::RequestError& error) {
+                rejected = error.kind() == ninfer::RequestErrorKind::ContextLengthExceeded;
+            }
+            require(rejected && engine.is_available(), "image budget failure was not rejected at admission");
+            // Admission rejection must preserve the earlier short-input checkpoint.
+            run("after-budget-error", short_image, {"red"}, true);
+        }
+        if (options.kvmem.disk_bytes) {
+            const auto usage = engine.memory_summary().kvmem;
+            require(usage.disk_read_bytes && usage.disk_written_bytes, "vision fixture did not exercise SSD");
+            std::cout << "MEMORY_VISION_SSD reads=" << usage.disk_read_bytes
+                      << " writes=" << usage.disk_written_bytes << std::endl;
+        }
+        std::cout << "MEMORY_VISION PASS" << std::endl;
+    } catch (const std::exception& error) {
+        std::cerr << error.what() << '\n';
+        return 1;
+    }
+}
diff --git a/tests/experimental/migration_concurrency.cpp b/tests/experimental/migration_concurrency.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..7313dd749d056ebdf726a5ed37f77e2a72c58615
--- /dev/null
+++ b/tests/experimental/migration_concurrency.cpp
@@ -0,0 +1,81 @@
+#include "ninfer/engine.h"
+#include "kvmem_test_options.h"
+#include <atomic>
+#include <future>
+#include <iostream>
+#include <stdexcept>
+#include <vector>
+
+// One short C8 batch and its restored repeat cover lane ownership and scheduling
+// without repeating the long-history stress suite.
+int main(int argc, char** argv) {
+    try {
+        if (argc != 2) throw std::invalid_argument("artifact");
+        ninfer::EngineOptions o;
+        ninfer::test::kvmem_test_devices(o);
+        o.artifact_path = argv[1];
+        o.device_profile = "off";
+        o.max_context = 2048;
+        o.max_concurrency = 8;
+        o.prefill_chunk = 128;
+        o.kv_cache = ninfer::KvCacheStorage::RotatedInt8KeyInt4ValueGroup64;
+        o.kv_capacity = ninfer::KvCapacityPolicy::explicit_capacity(8 * 256);
+        o.kvmem = {.selected_tokens = 128, .reserve_tokens = 128,
+            .host_bytes = 512ULL << 20, .retained_sessions = 8, .verify_transfers = true};
+        o.context_cache.enabled = false;
+        o.use_cuda_graph = true;
+        o.speculative.backend = ninfer::SpeculativeBackend::Mtp;
+        o.speculative.draft_tokens = 4;
+        o.speculative.mtp_policy = ninfer::MtpDraftPolicy::Adaptive;
+        o.speculative.ngram_draft_tokens = 15;
+        ninfer::Engine engine(o);
+        std::vector<ninfer::PromptInput> prompts(8);
+        for (unsigned row = 0; row < 8; ++row) {
+            auto& p = prompts[row];
+            p.context_cache.session_key = "migration-lane-" + std::to_string(row);
+            p.options.enable_thinking = false;
+            ninfer::ChatMessage m;
+            m.role = ninfer::ChatRole::User;
+            m.parts.push_back({.kind = ninfer::MessagePartKind::Text,
+                .text = "List integers from " + std::to_string(100 * row) + " in order."});
+            p.messages.push_back(std::move(m));
+        }
+        std::vector<std::vector<ninfer::TokenId>> previous(8);
+        for (unsigned round = 0; round < 2; ++round) {
+            const auto before = engine.runtime_stats();
+            std::vector<std::future<ninfer::GenerationResult>> futures;
+            for (const auto& p : prompts) {
+                ninfer::RequestOptions request;
+                request.execution.requested_output_tokens = 48;
+                request.execution.sampling.temperature = 0;
+                request.stop.include_model_defaults = false;
+                auto handle = engine.submit(engine.prepare(p), request);
+                futures.push_back(std::async(std::launch::async,
+                    [h = std::move(handle)]() mutable { return h.wait(); }));
+            }
+            for (unsigned row = 0; row < 8; ++row) {
+                const auto r = futures[row].get();
+                if (r.generated_token_ids.size() != 48 || (r.reused_prompt_tokens != 0) != (round != 0))
+                    throw std::runtime_error("C8 output or checkpoint ownership changed");
+                if (round && previous[row] != r.generated_token_ids)
+                    throw std::runtime_error("C8 checkpoint replay changed greedy output");
+                previous[row] = r.generated_token_ids;
+                std::cout << "C8 round=" << round << " lane=" << row
+                          << " reused=" << r.reused_prompt_tokens << '\n';
+            }
+            const auto usage = engine.memory_summary().kvmem;
+            const auto stats = engine.runtime_stats();
+            if (stats.decode_row_rounds - before.decode_row_rounds <=
+                stats.decode_rounds - before.decode_rounds)
+                throw std::runtime_error("C8 batch did not execute concurrent decode rows");
+            if (!engine.is_available() || usage.resident_pages || usage.mtp_resident_pages ||
+                usage.host_payload_bytes > o.kvmem.host_bytes)
+                throw std::runtime_error("C8 resources leaked or exceeded Host budget");
+        }
+        std::cout << "MIGRATION_C8 PASS\n";
+        return 0;
+    } catch (const std::exception& error) {
+        std::cerr << "MIGRATION_C8 FAIL " << error.what() << '\n';
+        return 1;
+    }
+}
diff --git a/tests/experimental/p1_engine.cpp b/tests/experimental/p1_engine.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..86ba972663d8092c132151a5bf5bccd8b74f624c
--- /dev/null
+++ b/tests/experimental/p1_engine.cpp
@@ -0,0 +1,99 @@
+#include "ninfer/engine.h"
+#include "kvmem_test_options.h"
+#include <chrono>
+#include <fstream>
+#include <iostream>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+// No HTTP shim: every case enters the public raw-token preparation, scheduler,
+// admission, Program prefill, ordinary decode, and request retirement paths.
+int main(int argc, char** argv) {
+    try {
+        if (argc != 6 && argc != 7) {
+            std::cerr << "artifact bf16|int8|nvfp4|k8v4|rk8v4 native|window graph|eager output-file [host-failure|long|smoke]\n";
+            return 2;
+        }
+        ninfer::EngineOptions o;
+        ninfer::test::kvmem_test_devices(o);
+        o.artifact_path = argv[1];
+        o.device = 0;
+        const std::string scenario = argc == 7 ? argv[6] : "boundaries";
+        o.max_context = scenario == "long" ? 32768 + 256 : 2048;
+        const bool window = std::string(argv[3]) == "window";
+        if (window) {
+            o.kvmem.selected_tokens = 128;
+            o.kvmem.reserve_tokens = 128;
+            o.kvmem.host_bytes = (scenario == "long" ? 4ULL : 1ULL) * 1024ULL * 1024ULL * 1024ULL;
+            o.kvmem.verify_transfers = true;
+            if (scenario == "host-failure") { o.kvmem.host_bytes = 1; }
+        }
