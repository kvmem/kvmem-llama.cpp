+// === turbo TCQ materialize: dequant K/V to f16 via inverse FWHT (original domain) ===
+static __device__ __forceinline__ void fwht128_store_half(float val, half * dst_base) {
+    const int tid = threadIdx.x;
+    const float neighbor = __shfl_xor_sync(0xFFFFFFFFULL, val, 1);
+    if ((tid & 1) == 0) {
+        const half2 packed = __floats2half2_rn(val, neighbor);
+        *((half2 *)(dst_base + tid)) = packed;
+    }
