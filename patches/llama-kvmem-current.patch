+        static float alpha_v_static = -1.0f;
+        if (alpha_v_static < 0.0f) {
+            alpha_v_static = 0.0f;
+            const char * s = getenv("TURBO_TCQ_DECODE_ALPHA_V");
+            if (s) {
+                char * end;
+                float a = strtof(s, &end);
+                if (end != s && a > 0.0f && a < 10.0f) alpha_v_static = a;
