+static half * g_turbo_k16[GGML_CUDA_MAX_DEVICES] = {};
+static size_t g_turbo_k16_size[GGML_CUDA_MAX_DEVICES] = {};
+static half * g_turbo_v16[GGML_CUDA_MAX_DEVICES] = {};
+static size_t g_turbo_v16_size[GGML_CUDA_MAX_DEVICES] = {};
+
+static half * turbo_f16_scratch(half ** buf, size_t * buf_size, size_t need) {
+    if (need > *buf_size) {
+        half * nb = nullptr;
+        CUDA_CHECK(cudaMalloc((void **) &nb, need));
+        *buf = nb;
+        *buf_size = need;
+    }
+    return *buf;
+}
