+// Dequant turbo TCQ K/V to f16 (inverse FWHT -> original domain) then run the native f16 FA path.
+// Using inverse FWHT on V too makes the graph-level output un-rotation unnecessary (WHT is linear).
+static void ggml_cuda_flash_attn_ext_turbo_tcq(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    ggml_tensor * K = dst->src[1];
+    ggml_tensor * V = dst->src[2];
+    cudaStream_t stream = ctx.stream();
+
+    const size_t k_bytes = (size_t) K->ne[0]*K->ne[1]*K->ne[2]*K->ne[3]*sizeof(half);
+    const size_t v_bytes = (size_t) V->ne[0]*V->ne[1]*V->ne[2]*V->ne[3]*sizeof(half);
+    const int dev = ggml_cuda_get_device();
+    half * k16 = turbo_f16_scratch(&g_turbo_k16[dev], &g_turbo_k16_size[dev], k_bytes);
+    half * v16 = turbo_f16_scratch(&g_turbo_v16[dev], &g_turbo_v16_size[dev], v_bytes);
+
+    dim3 grid_k((unsigned) K->ne[1], (unsigned) K->ne[2], (unsigned) K->ne[3]);
+    if (K->type == GGML_TYPE_TURBO3_TCQ) {
+        k_turbo3_tcq_dequant_f16_inv_fwht<<<grid_k, 128, 0, stream>>>(
+            (const char *) K->data, k16, K->ne[0], K->ne[1], K->ne[2], K->nb[1], K->nb[2], K->nb[3], 1.0f, 0);
+    } else if (K->type == GGML_TYPE_TURBO2_TCQ) {
+        k_turbo2_tcq_dequant_f16_inv_fwht<<<grid_k, 128, 0, stream>>>(
+            (const char *) K->data, k16, K->ne[0], K->ne[1], K->ne[2], K->nb[1], K->nb[2], K->nb[3], 1.0f, 0);
+    } else if (K->type == GGML_TYPE_TURBO4_0) {
+        k_turbo4_dequant_f16_inv_fwht<<<grid_k, 128, 0, stream>>>(
+            (const char *) K->data, k16, K->ne[0], K->ne[1], K->ne[2], K->nb[1], K->nb[2], K->nb[3]);
+    } else {
+        k_turbo8_dequant_f16_inv_fwht<<<grid_k, 128, 0, stream>>>(
+            (const char *) K->data, k16, K->ne[0], K->ne[1], K->ne[2], K->nb[1], K->nb[2], K->nb[3]);
+    }
+
+    dim3 grid_v((unsigned) V->ne[1], (unsigned) V->ne[2], (unsigned) V->ne[3]);
+    const float alpha_v = (V->type == GGML_TYPE_TURBO3_TCQ) ? 1.02f : 1.06f; // TURBO_TCQ_ALPHA_V_T{3,2}
+    if (V->type == GGML_TYPE_TURBO3_TCQ) {
+        k_turbo3_tcq_dequant_f16_inv_fwht<<<grid_v, 128, 0, stream>>>(
+            (const char *) V->data, v16, V->ne[0], V->ne[1], V->ne[2], V->nb[1], V->nb[2], V->nb[3], alpha_v, 1);
+    } else if (V->type == GGML_TYPE_TURBO2_TCQ) {
+        k_turbo2_tcq_dequant_f16_inv_fwht<<<grid_v, 128, 0, stream>>>(
+            (const char *) V->data, v16, V->ne[0], V->ne[1], V->ne[2], V->nb[1], V->nb[2], V->nb[3], alpha_v, 1);
+    } else if (V->type == GGML_TYPE_TURBO4_0) {
+        k_turbo4_dequant_f16_inv_fwht<<<grid_v, 128, 0, stream>>>(
+            (const char *) V->data, v16, V->ne[0], V->ne[1], V->ne[2], V->nb[1], V->nb[2], V->nb[3]);
+    } else {
+        k_turbo8_dequant_f16_inv_fwht<<<grid_v, 128, 0, stream>>>(
+            (const char *) V->data, v16, V->ne[0], V->ne[1], V->ne[2], V->nb[1], V->nb[2], V->nb[3]);
+    }
+
+    ggml_tensor K16 = *K;
+    ggml_tensor V16 = *V;
+    K16.type = GGML_TYPE_F16; K16.data = k16;
+    K16.nb[0] = sizeof(half);
+    K16.nb[1] = K->ne[0]*K->ne[2]*sizeof(half);
+    K16.nb[2] = K->ne[0]*sizeof(half);
+    K16.nb[3] = K->ne[0]*K->ne[1]*K->ne[2]*sizeof(half);
+    V16.type = GGML_TYPE_F16; V16.data = v16;
+    V16.nb[0] = sizeof(half);
+    V16.nb[1] = V->ne[0]*V->ne[2]*sizeof(half);
+    V16.nb[2] = V->ne[0]*sizeof(half);
+    V16.nb[3] = V->ne[0]*V->ne[1]*V->ne[2]*sizeof(half);
+
+    ggml_tensor * o_k = dst->src[1];
+    ggml_tensor * o_v = dst->src[2];
+    dst->src[1] = &K16;
+    dst->src[2] = &V16;
+    ggml_cuda_flash_attn_ext_vec(ctx, dst);
+    dst->src[1] = o_k;
+    dst->src[2] = o_v;
