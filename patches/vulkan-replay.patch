+bool ggml_backend_vk_gdn_fold(
+        ggml_backend_t backend,
+        const ggml_vk_gdn_replay_layer * layers,
+        int n_layers, int n_keep, int capacity) {
+    if (n_keep == 0) {
+        return true;
+    }
+    if (!ggml_backend_is_vk(backend) || !layers || n_layers <= 0 || n_keep < 0 || n_keep > capacity || capacity > 6) {
+        return false;
+    }
+
+    ggml_backend_vk_context * ctx = (ggml_backend_vk_context *) backend->context;
+    auto valid = [&](const ggml_tensor * tensor, int64_t elements) {
+        if (!tensor || !tensor->buffer || tensor->type != GGML_TYPE_F32 || !ggml_is_contiguous(tensor) || ggml_nelements(tensor) != elements ||
+                !ggml_backend_buffer_is_vk(tensor->buffer)) {
+            return false;
+        }
+        const auto * buf_ctx = (const ggml_backend_vk_buffer_context *) tensor->buffer->context;
+        const size_t offset = vk_tensor_offset(tensor) + tensor->view_offs;
+        return buf_ctx->dev_buffer->device == ctx->device &&
+                offset % ctx->device->properties.limits.minStorageBufferOffsetAlignment == 0;
+    };
+
+    for (int il = 0; il < n_layers; ++il) {
+        const auto & layer = layers[il];
+        if (!valid(layer.state, 128 * 128 * 48) || !valid(layer.conv, 3 * 10240) ||
+                !valid(layer.key, capacity * 2048) || !valid(layer.value, capacity * 6144) ||
+                !valid(layer.gate, capacity * 48) || !valid(layer.beta, capacity * 48) ||
+                !valid(layer.conv_input, capacity * 10240)) {
+            return false;
+        }
+    }
+
+    ggml_pipeline_request_descriptor_sets(ctx, ctx->device->pipeline_gdn_replay_fold, n_layers);
+    ggml_pipeline_request_descriptor_sets(ctx, ctx->device->pipeline_gdn_replay_conv, n_layers);
+    vk_context compute_ctx = ggml_vk_get_compute_ctx(ctx);
+    const vk_op_gdn_replay_push_constants pc{(uint32_t) n_keep};
+
+    for (int il = 0; il < n_layers; ++il) {
+        const auto & layer = layers[il];
+        ggml_vk_dispatch_pipeline(ctx, compute_ctx, ctx->device->pipeline_gdn_replay_fold,
+            {ggml_vk_tensor_subbuffer(ctx, layer.state), ggml_vk_tensor_subbuffer(ctx, layer.key),
+             ggml_vk_tensor_subbuffer(ctx, layer.value), ggml_vk_tensor_subbuffer(ctx, layer.gate),
+             ggml_vk_tensor_subbuffer(ctx, layer.beta)},
+            pc, {48, 1, 128});
+        ggml_vk_dispatch_pipeline(ctx, compute_ctx, ctx->device->pipeline_gdn_replay_conv,
+            {ggml_vk_tensor_subbuffer(ctx, layer.conv), ggml_vk_tensor_subbuffer(ctx, layer.conv_input)},
+            pc, {10240, 1, 1});
+    }
+
+    ggml_vk_ctx_end(compute_ctx);
+    ggml_vk_submit(compute_ctx, {});
+    ctx->submit_pending = true;
+    ctx->compute_ctx.reset();
+    ggml_backend_vk_synchronize(backend);
+    return true;
+}
