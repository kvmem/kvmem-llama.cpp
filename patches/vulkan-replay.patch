@@ -0,0 +1,105 @@
+#version 450
+
+#extension GL_GOOGLE_include_directive : require
+
+#extension GL_EXT_control_flow_attributes : require
+#extension GL_KHR_shader_subgroup_basic : enable
+#if USE_SUBGROUP_CLUSTERED
+#extension GL_KHR_shader_subgroup_clustered : enable
+#endif
+#if USE_SUBGROUP_ADD
+#extension GL_KHR_shader_subgroup_arithmetic : enable
+#endif
+
+layout(constant_id = 0) const uint SUBGROUP_SIZE = 32;
+layout(constant_id = 1) const uint LANES_PER_COLUMN = 32;
+
+const uint S_V = 128;
+const uint H_K = 16;
+const uint H_V = 48;
+const uint COLS_PER_WG = SUBGROUP_SIZE / LANES_PER_COLUMN;
+const uint ROWS_PER_LANE = S_V / LANES_PER_COLUMN;
+
+layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;
+
+layout(push_constant) uniform Parameters {
+    uint n_keep;
+};
+
+layout(binding = 0) buffer StateBuf { float state[]; };
+layout(binding = 1) readonly buffer KeyBuf { float key[]; };
+layout(binding = 2) readonly buffer ValueBuf { float value[]; };
+layout(binding = 3) readonly buffer GateBuf { float gate[]; };
+layout(binding = 4) readonly buffer BetaBuf { float beta[]; };
+
+#if !USE_SUBGROUP_ADD && !USE_SUBGROUP_CLUSTERED
+shared float temp[SUBGROUP_SIZE];
+
+float reduce_add_shmem(float partial) {
+    const uint lane = gl_SubgroupInvocationID;
+    temp[lane] = partial;
+    barrier();
+    [[unroll]] for (uint s = LANES_PER_COLUMN / 2u; s > 0; s >>= 1u) {
+        const float other = temp[lane ^ s];
+        barrier();
+        temp[lane] += other;
+        barrier();
+    }
+    const float result = temp[lane];
+    barrier();
+    return result;
+}
+#endif
+
+float reduce_partial(float partial) {
+    switch (LANES_PER_COLUMN) {
+        case 1u:
+            return partial;
+#if USE_SUBGROUP_CLUSTERED
+        case 2u:  return subgroupClusteredAdd(partial, 2u);
+        case 4u:  return subgroupClusteredAdd(partial, 4u);
+        case 8u:  return subgroupClusteredAdd(partial, 8u);
+        case 16u: return subgroupClusteredAdd(partial, 16u);
+        case 32u: return subgroupClusteredAdd(partial, 32u);
+        case 64u: return subgroupClusteredAdd(partial, 64u);
+#endif
+        default:
+#if USE_SUBGROUP_ADD
+            return subgroupAdd(partial);
+#else
+            return reduce_add_shmem(partial);
+#endif
+    }
+}
+
+#include "gdn_replay_math.glsl"
+
+void main() {
+    const uint head = gl_WorkGroupID.x;
+    const uint lane = gl_SubgroupInvocationID % LANES_PER_COLUMN;
+    const uint col = gl_WorkGroupID.z * COLS_PER_WG + gl_SubgroupInvocationID / LANES_PER_COLUMN;
+    const uint state_base = (head * S_V + col) * S_V;
+
+    float s[ROWS_PER_LANE];
+    [[unroll]] for (uint r = 0; r < ROWS_PER_LANE; ++r) {
+        s[r] = state[state_base + r * LANES_PER_COLUMN + lane];
+    }
+
+    for (uint t = 0; t < n_keep; ++t) {
+        const uint key_base = (t * H_K + head % H_K) * S_V;
+        const float decay = exp(gate[t * H_V + head]);
+        float k[ROWS_PER_LANE];
+        [[unroll]] for (uint r = 0; r < ROWS_PER_LANE; ++r) {
+            const uint row = r * LANES_PER_COLUMN + lane;
+            k[r] = key[key_base + row];
+        }
+        const float delta = gdn_delta_f32(s, k, decay, value[(t * H_V + head) * S_V + col], beta[t * H_V + head]);
+        [[unroll]] for (uint r = 0; r < ROWS_PER_LANE; ++r) {
+            s[r] = gdn_update_f32(s[r], k[r], decay, delta);
+        }
+    }
+
+    [[unroll]] for (uint r = 0; r < ROWS_PER_LANE; ++r) {
+        state[state_base + r * LANES_PER_COLUMN + lane] = s[r];
+    }
+}
