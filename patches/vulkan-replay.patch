@@ -0,0 +1,32 @@
+#version 450
+
+#extension GL_EXT_control_flow_attributes : require
+
+layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
+
+const uint CHANNELS = 10240;
+const uint HISTORY = 3;
+
+layout(push_constant) uniform Parameters {
+    uint n_keep;
+};
+
+layout(binding = 0) buffer ConvBuf { float conv[]; };
+layout(binding = 1) readonly buffer InputBuf { float input_data[]; };
+
+void main() {
+    const uint channel = gl_GlobalInvocationID.x;
+    if (channel >= CHANNELS) {
+        return;
+    }
+
+    float history[HISTORY];
+    [[unroll]] for (uint i = 0; i < HISTORY; ++i) {
+        const uint source = n_keep + i;
+        history[i] = source < HISTORY ? conv[channel * HISTORY + source]
+                                      : input_data[(source - HISTORY) * CHANNELS + channel];
+    }
+    [[unroll]] for (uint i = 0; i < HISTORY; ++i) {
+        conv[channel * HISTORY + i] = history[i];
+    }
+}
