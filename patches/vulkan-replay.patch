+++ b/ggml/src/ggml-vulkan/vulkan-shaders/gdn_replay_math.glsl
@@ -0,0 +1,13 @@
+// Match the CUDA GDN recurrence in both forward and accepted-prefix fold.
+float gdn_delta_f32(float state[ROWS_PER_LANE], float key[ROWS_PER_LANE], float decay, float value, float beta) {
+    float partial = 0.0;
+    [[unroll]] for (uint r = 0; r < ROWS_PER_LANE; ++r) {
+        partial += state[r] * key[r];
+    }
+    const float dot = reduce_partial(partial);
+    return (value - decay * dot) * beta;
+}
+
+float gdn_update_f32(float state, float key, float decay, float delta) {
+    return decay * state + key * delta;
+}
